EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY is server-side only — set it via: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<key>
# Never add it here with EXPO_PUBLIC_ prefix — it would be exposed in the app bundle.
EXPO_PUBLIC_SENTRY_DSN=https://your-key@oXXXXX.ingest.sentry.io/XXXXXXX
