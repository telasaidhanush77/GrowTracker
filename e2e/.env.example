# ── GrowTracker E2E credentials ────────────────────────────────────────────────
# Copy this file to e2e/.env and fill in real values.
# All variables are passed to Maestro via: maestro test --env-file e2e/.env e2e/
#
# Pre-seed these accounts in your TEST Supabase project before running:
#   • EMPLOYEE_USER / EMPLOYEE_PASS  → role: employee
#   • MANAGER_USER  / MANAGER_PASS   → role: manager
#
# The signup test (auth/02_signup.yaml) creates a brand-new account.
# Use a unique email per test run, or delete the account in Supabase between runs.

EMPLOYEE_USER=e2e.employee@growtracker.test
EMPLOYEE_PASS=TestPass123!

MANAGER_USER=e2e.manager@growtracker.test
MANAGER_PASS=TestPass123!

ADMIN_USER=e2e.admin@growtracker.test
ADMIN_PASS=TestPass123!

# Unique-per-run email for the signup test.
# Change or delete the Supabase user between runs to avoid "email already in use".
SIGNUP_EMAIL=e2e.signup@growtracker.test
